# LLM API keys (used by Tri-Modal execution experiments §4 / §5.4.2 of the paper).
# Copy this file to `.env` and fill in your own keys, OR export them as shell
# environment variables before running `simulation_workspace/*.py`.

# OpenAI-compatible endpoint key (used by default).
OPENAI_API_KEY=

# Aliyun DashScope key (used when explicitly selecting Qwen models).
DASHSCOPE_API_KEY=
