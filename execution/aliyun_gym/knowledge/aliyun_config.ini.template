# Aliyun-Gym 配置文件模板
# 复制此文件为 aliyun_config.ini 并填入真实的 AK/SK（可选）
# 注意：API 元信息获取使用公开接口，不需要认证
# 此配置预留给未来可能需要认证的扩展场景
# 暂时用不上

[aliyun]
# 阿里云 AccessKey ID
access_key_id = YOUR_ACCESS_KEY_ID

# 阿里云 AccessKey Secret
access_key_secret = YOUR_ACCESS_KEY_SECRET

# 默认地域
region_id = cn-hangzhou


[fetch]
# 要抓取的服务列表（逗号分隔）
services = vpc,ecs,rds,slb,redis,eip,cms,oos

# API 元信息输出目录
output_dir = ./api_docs

# 请求超时时间（秒）
timeout = 30
