          "in": "query",
          "required": true,
          "type": "integer",
          "description": "应用分组ID。",
          "example": "123456"
        },
        {
          "name": "TaskName",
          "in": "query",
          "required": true,
          "type": "string",
          "description": "可用性监控任务名称。取值范围：4~100个字符，支持英文字母、数字、下划线（_）和汉字。",
          "example": "task1"
        },
        {
          "name": "TaskScope",
          "in": "query",
          "required": false,
