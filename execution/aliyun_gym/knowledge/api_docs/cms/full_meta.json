    "CreateHostAvailability": {
      "name": "",
      "summary": "调用CreateHostAvailability接口创建可用性监控任务。",
      "description": "本文将提供一个示例，在应用分组`123456`中创建探测类型为`HTTP`的可用性监控任务`task1`，通过邮件和钉钉机器人给您发送报警。\n\n",
      "parameters": [
        {
