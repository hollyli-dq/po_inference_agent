          "example": "GROUP"
        },
        {
          "name": "TaskType",
          "in": "query",
          "required": true,
          "type": "string",
          "description": "可用性监控任务的探测类型。取值：\n\n- PING\n- TELNET\n- HTTP",
          "example": "HTTP"
        },
        {
          "name": "TaskOption.HttpURI",
          "in": "query",
          "required": false,
          "type": "string",
          "description": "HTTP、Telnet探测类型的探测URI地址。",
          "example": "https://www.aliyun.com\ntelnet://127.0.0.1:80"
        },
        {
          "name": "TaskOption.TelnetOrPingHost",
          "in": "query",
          "required": false,
          "type": "string",
          "description": "探测的域名或地址。\n>如果探测任务类型为PING，则需要设置该参数。",
          "example": "www.aliyun.com"
        },
        {
          "name": "TaskOption.HttpResponseCharset",
          "in": "query",
          "required": false,
          "type": "string",
          "description": "HTTP探测类型的响应字符集。\n\n> 仅支持UTF-8。",
          "example": "UTF-8"
        },
        {
          "name": "TaskOption.HttpPostContent",
          "in": "query",
          "required": false,
          "type": "string",
          "description": "HTTP探测类型探测请求的Post内容。",
          "example": "params1=paramsValue1"
        },
        {
          "name": "TaskOption.HttpResponseMatchContent",
          "in": "query",
          "required": false,
          "type": "string",
          "description": "匹配响应的内容。",
          "example": "ok"
        },
        {
          "name": "TaskOption.HttpMethod",
          "in": "query",
          "required": false,
          "type": "string",
          "description": "探测类型的方法。取值：\n\n- GET\n- POST\n- HEAD\n\n>如果任务的探测类型为HTTP，则需要设置该参数。",
          "example": "GET"
        },
        {
          "name": "TaskOption.HttpNegative",
          "in": "query",
          "required": false,
